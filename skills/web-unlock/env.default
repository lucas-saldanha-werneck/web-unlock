# web-unlock settings and API keys. Read by fetch.sh, search.sh, chrome-real.sh and cdp.mjs.
# This file was created by web-unlock on its first run. Plugin updates never touch it.
# Every line below is commented out, so each setting keeps its default. To change one, remove the "#".
# A variable already set in your environment wins over this file. Keep this file private (chmod 600).
# WEB_UNLOCK_HOME and WEB_UNLOCK_ENV can only be set in the environment, not here.

# Site registry. Default: sites.json in this folder if it exists, else the plugin's bundled example.
# WEB_UNLOCK_SITES=

# Search providers search.sh tries, in order (space or comma separated; ones left out are skipped).
# WEB_UNLOCK_SEARCH_ORDER="exa-mcp exa serper tavily firecrawl"

# Where fetched pages go when -o is not given. Default: $TMPDIR/web-unlock (or /tmp/web-unlock).
# WEB_UNLOCK_TMP=

# Accept-Language header for plain curl.
# WEB_UNLOCK_ACCEPT_LANGUAGE="en-US,en;q=0.9"

# User-Agent for plain curl. Default: a recent desktop Chrome on macOS.
# WEB_UNLOCK_UA=

# 1 = fetch.sh skips Scrapling.
# WEB_UNLOCK_NO_SCRAPLING=0

# CDP port of the automation Chrome (9222 is usually your main Chrome's).
# CHROME_REAL_PORT=9223

# Profile folder of the automation Chrome. Your real Chrome profile is refused.
# CHROME_REAL_PROFILE="$HOME/.chrome-automation-profile"

# Browser chrome-real.sh launches. Default: macOS Chrome Beta if installed, else Chrome;
# Linux the first of google-chrome-beta, google-chrome, chromium.
# CHROME_REAL_APP=

# Where cdp.mjs finds playwright-core. Default: local, then global npm.
# PLAYWRIGHT_CORE_PATH=

# API keys, each optional. Without one, that provider or layer is skipped.
# EXA_API_KEY=
# SERPER_API_KEY=
# JINA_API_KEY=
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_UNLOCKER_ZONE=
